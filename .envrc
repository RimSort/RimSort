# shellcheck shell=bash
# direnv: load the Nix dev shell when Nix is installed, otherwise activate the
# uv-managed .venv (create it with `just dev-setup`). Set RIMSORT_NO_NIX=1 or
# override anything in .envrc.local (not committed).
source_env_if_exists .envrc.local

if has nix && [[ -z ${RIMSORT_NO_NIX-} ]]; then
	# nix-direnv only watches flake.nix / flake.lock by itself
	watch_file nix/parts/*.nix pyproject.toml uv.lock
	use flake
elif [[ -d .venv ]]; then
	export VIRTUAL_ENV="$PWD/.venv"
	PATH_add .venv/bin
fi
