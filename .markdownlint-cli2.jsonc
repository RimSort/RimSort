// markdownlint-cli2 options (local check/fix mode).
// The rule set lives in .markdownlint.json, which is read by BOTH
// markdownlint-cli2 (via `just markdownlint-fix`) and super-linter (CI, via
// MARKDOWN_CONFIG_FILE) so that policies stay in sync. Do not add a `config`
// property here: a .markdownlint.json in the same directory overrides it
// automatically.
{
  "noBanner": true,
  "noProgress": true,
  "globs": [
    "docs/**/*.md",
    "*.md"
  ],
  "ignores": [
    "LICENSE.md"
  ]
}
